{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow"
    },
    "lsp": "deny",
    "webfetch": "ask",
    "task": "ask",
    "external_directory": {
      "C:\\Users\\x\\.config\\kilo\\*": "allow",
      "*": "deny"
    },
    "bash": {
      "*": "ask",
      "bash *": "ask",
      "git check-ignore *": "allow",
      "Get-Content *": "allow",
      "Select-Object *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "npx *": "ask",
      "Get-ChildItem *": "allow",
      "Write-Output *": "allow",
      "Format-Table *": "allow",
      "echo *": "allow",
      "Test-Path *": "allow",
      "Get-Item *": "allow",
      "python -c *": "allow",
      "python \"C:\\githubProjects\\playwrightProjects\\captcha\\test_vision_copy.py\" *": "allow",
      "python test_vision_paligemma.py *": "allow",
      "Invoke-WebRequest *": "allow",
      "Select-String *": "allow",
      "ForEach-Object *": "allow",
      "Measure-Object *": "allow"
    },
    "doom_loop": "ask"
  },
  "disabled_providers": [],
